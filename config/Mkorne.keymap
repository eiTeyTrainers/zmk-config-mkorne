#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define GAMING  1
#define NUMBERS 2
#define SYMBOLS 3

/ {
    behaviors {

        // ================================================================
        // ALT + SHIFT LANGUAGE SWITCH
        //
        // Tap  = LANG1
        // Hold = ALT
        // ================================================================
        alt_lang: alt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };

        // ================================================================
        // NUMBERS / BACKSPACE
        //
        // Tap  = Backspace
        // Hold = NUMBERS layer
        // ================================================================
        unreal_numbers: unreal_numbers {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&mo>, <&kp>;
        };

        // ================================================================
        // GAMING TOGGLE
        //
        // Sends F13 first so the PC-side overlay can detect the change,
        // then toggles the GAMING layer.
        // ================================================================
        gaming_marker: gaming_marker {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_tap &kp F13>,
                <&tog GAMING>;
        };

        // ================================================================
        // GAMING / SYMBOLS
        //
        // Tap  = toggle GAMING
        // Hold = SYMBOLS
        // ================================================================
        gaming_symbols: gaming_symbols {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&mo>, <&gaming_marker>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ================================================================
        // DEFAULT
        // ================================================================
        default_layer {
            bindings = <
                &kp ESC       &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y         &kp U       &kp I       &kp O       &kp P       &kp ENTER

                &kp TAB       &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H         &kp J       &kp K       &kp L       &kp SEMI     &kp SQT

                &kp LSHFT     &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N         &kp M       &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT

                &kp LCTRL
                &alt_lang LALT LANG1
                &kp SPACE

                &unreal_numbers NUMBERS BSPC
                &kp BSPC
                &gaming_symbols SYMBOLS 0
            >;
        };

        // ================================================================
        // GAMING
        //
        // Tap the bottom-right key to EXIT GAMING.
        //
        // Arrow cluster:
        //
        //             I = UP
        //
        //         J = LEFT   K = DOWN   L = RIGHT
        // ================================================================
        gaming_layer {
            bindings = <
                &kp TAB       &kp Q        &kp W        &kp E        &kp R        &kp T
                &kp Y         &kp U        &kp I        &kp O        &kp P        &kp ESC

                &kp LSHFT     &kp A        &kp S        &kp D        &kp F        &kp G
                &kp H         &kp J        &kp K        &kp L        &kp SEMI     &kp SQT

                &kp LCTRL     &kp Z        &kp X        &kp C        &kp V        &kp B
                &kp N         &kp M        &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT

                &kp LCTRL
                &kp LALT
                &kp SPACE

                &kp LGUI
                &kp BSPC
                &gaming_marker
            >;
        };

        // ================================================================
        // NUMBERS
        //
        // Hold the UNREAL thumb key to access this layer.
        //
        // LEFT SIDE = Bluetooth / output controls
        //
        // RIGHT SIDE = NUMPAD
        // ================================================================
        numbers_layer {
            bindings = <
                // Row 1
                &trans       &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4
                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS       &trans             &trans

                // Row 2
                &trans       &bt BT_CLR         &out OUT_TOG       &trans             &trans             &trans
                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS      &trans             &trans

                // Row 3
                &trans       &bt BT_CLR_ALL     &trans             &trans             &trans             &trans
                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY   &trans             &trans

                // Thumb row
                &trans
                &trans
                &trans

                &kp KP_NUMBER_0
                &kp KP_DOT
                &kp KP_DIVIDE
            >;
        };

        // ================================================================
        // SYMBOLS
        //
        // Programming symbols.
        //
        // Main operators:
        //   < > = + - * / %
        //
        // Punctuation:
        //   ; : ' " ` ~
        //
        // Other:
        //   \ | _
        // ================================================================
        symbols_layer {
            bindings = <
                // Row 1
                &trans       &kp LT       &kp GT       &kp EQUAL       &kp PLUS        &kp MINUS
                &kp ASTERISK &kp SLASH    &kp PRCNT    &kp UNDERSCORE  &kp BSLH        &kp PIPE

                // Row 2
                &trans       &kp SEMI     &kp COLON    &kp SQT         &kp DQT         &kp GRAVE
                &kp TILDE    &trans       &trans       &trans          &trans          &trans

                // Row 3
                &trans       &trans       &trans       &trans          &trans          &trans
                &trans       &trans       &trans       &trans          &trans          &trans

                // Thumb row
                &trans
                &trans
                &trans

                &trans
                &trans
                &trans
            >;
        };
    };
};