#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

/ {
    keymap {
        compatible = "zmk,keymap";


        // ================================================================
        // LAYER 0 — DEFAULT
        // ================================================================
        //
        //   ESC   Q   W   E   R   T       Y   U   I   O   P   BSPC
        //   TAB   A   S   D   F   G       H   J   K   L   ;   '
        //   SHIFT Z   X   C   V   B       N   M   ,   .   /   SHIFT
        //
        //             CTRL   LOWER   SPACE
        //             ENTER  RAISE   ALT
        //
        // ================================================================

        default_layer {
            bindings = <

                // ---------------- ROW 1 ----------------

                &kp ESC
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T

                &kp Y
                &kp U
                &kp I
                &kp O
                &kp P
                &kp BSPC


                // ---------------- ROW 2 ----------------

                &kp TAB
                &kp A
                &kp S
                &kp D
                &kp F
                &kp G

                &kp H
                &kp J
                &kp K
                &kp L
                &kp SEMI
                &kp SQT


                // ---------------- ROW 3 ----------------

                &kp LSHFT
                &kp Z
                &kp X
                &kp C
                &kp V
                &kp B

                &kp N
                &kp M
                &kp COMMA
                &kp DOT
                &kp FSLH
                &kp RSHFT


                // ---------------- THUMBS ----------------

                &kp LCTRL
                &mo LOWER
                &kp SPACE

                &kp ENTER
                &mo RAISE
                &kp LALT
            >;
        };


        // ================================================================
        // LAYER 1 — LOWER
        // ================================================================
        //
        //   `     1   2   3   4   5       6   7   8   9   0   BSPC
        //   ~     !   @   #   $   %       ^   &   *   (   )   \
        //   |     -   _   =   +   *       PRT [   ]   {   }   SHIFT
        //
        //             CTRL   ----   SPACE
        //             ENTER  ----   END
        //
        // ================================================================

        lower_layer {
            bindings = <

                // ---------------- ROW 1 ----------------

                &kp GRAVE
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5

                &kp N6
                &kp N7
                &kp N8
                &kp N9
                &kp N0
                &kp BSPC


                // ---------------- ROW 2 ----------------

                &kp TILDE
                &kp EXCL
                &kp AT
                &kp HASH
                &kp DLLR
                &kp PRCNT

                &kp CARET
                &kp AMPS
                &kp ASTERISK
                &kp LPAR
                &kp RPAR
                &kp BSLH


                // ---------------- ROW 3 ----------------

                &kp PIPE
                &kp MINUS
                &kp UNDER
                &kp EQUAL
                &kp PLUS
                &kp ASTERISK

                &kp PRINTSCREEN
                &kp LBKT
                &kp RBKT
                &kp LBRC
                &kp RBRC
                &kp RSHFT


                // ---------------- THUMBS ----------------

                &kp LCTRL
                &trans
                &kp SPACE

                &kp ENTER
                &trans
                &kp END
            >;
        };


        // ================================================================
        // LAYER 2 — RAISE
        // ================================================================
        //
        //   ESC   F1   F2   F3   F4   F5       Ctrl+Shift+F3   Ctrl-   UP   Ctrl+Shift-   Ctrl+F3   DEL
        //   TAB   F6   F7   F8   F9   F10      Ctrl+Shift+LEFT DOWN   RIGHT Ctrl+Shift+RIGHT PGUP
        //   SHIFT BTCLR BT1  BT2  F11  F12      Ctrl+W   Ctrl+P   Ctrl+K   Ctrl+N   Alt+F4   PGDN
        //
        //             HOME   ALT   SPACE
        //             ENTER  ----  ALT
        //
        // ================================================================

        raise_layer {
            bindings = <

                // ---------------- ROW 1 ----------------

                &kp ESC
                &kp F1
                &kp F2
                &kp F3
                &kp F4
                &kp F5

                &kp LC(LS(F3))
                &kp LC(MINUS)
                &kp UP
                &kp LC(LS(MINUS))
                &kp LC(F3)
                &kp DELETE


                // ---------------- ROW 2 ----------------

                &kp TAB
                &kp F6
                &kp F7
                &kp F8
                &kp F9
                &kp F10

                &kp LC(LS(LEFT))
                &kp DOWN
                &kp RIGHT
                &kp LC(LS(RIGHT))
                &kp PG_UP
                &kp PAGE_UP


                // ---------------- ROW 3 ----------------

                &kp LSHFT
                &bt BT_CLR
                &bt BT_NXT
                &bt BT_PRV
                &kp F11
                &kp F12

                &kp LC(W)
                &kp LC(P)
                &kp LC(K)
                &kp LC(N)
                &kp LA(F4)
                &kp PAGE_DOWN


                // ---------------- THUMBS ----------------

                &kp HOME
                &kp LALT
                &kp SPACE

                &kp ENTER
                &trans
                &kp LALT
            >;
        };
    };
};