#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define GAMING  1
#define NUMBERS 2

/ {
    behaviors {
        alt_lang: alt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };

                : alt_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ================================================================
        // DEFAULT LAYER
        // ================================================================

        default_layer {
            bindings = <
                &kp ESC       &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y        &kp U       &kp I       &kp O       &kp P       &kp ENTER

                &kp TAB       &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H        &kp J       &kp K       &kp L       &kp SEMI     &kp SQT

                &kp LSHFT     &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N        &kp M       &kp COMMA    &kp DOT     &kp SLASH    &kp RSHFT

                            &lt GAMING LGUI
                            &alt_lang LALT LANG1
                            &kp SPACE

                            &kp RCTRL
                            &kp BSPC
                            &lt NUMBERS RALT
            >;
        };

        // ================================================================
        // GAMING LAYER
        //
        // Numbers are on the top row.
        // WASD stays in its normal position.
        // ================================================================

        gaming_layer {
            bindings = <
                &kp ESC       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5
                &kp N6        &kp N7       &kp N8       &kp N9       &kp N0       &kp ENTER

                &kp TAB       &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y        &kp U       &kp I       &kp O       &kp P       &kp SQT

                &kp LCTRL     &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H        &kp J       &kp K       &kp L       &kp SEMI     &kp RSHFT

                            &kp LALT
                            &kp SPACE
                            &kp RCTRL

                            &kp LALT
                            &kp BSPC
                            &to DEFAULT
            >;
        };

        // ================================================================
        // NUMBERS LAYER
        //
        // Right-hand numpad:
        //
        //       7   8   9   +
        //       4   5   6   -
        //       1   2   3   *
        //       0   .   /   =
        //
        // 0 / . / = are on the right thumb keys.
        // ================================================================

        numbers_layer {
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans
                &kp KP_NUMBER_7
                &kp KP_NUMBER_8
                &kp KP_NUMBER_9
                &kp KP_PLUS
                &trans       &trans

                &trans       &trans       &trans       &trans       &trans       &trans
                &kp KP_NUMBER_4
                &kp KP_NUMBER_5
                &kp KP_NUMBER_6
                &kp KP_MINUS
                &trans       &trans

                &trans       &trans       &trans       &trans       &trans       &trans
                &kp KP_NUMBER_1
                &kp KP_NUMBER_2
                &kp KP_NUMBER_3
                &kp KP_MULTIPLY
                &trans       &trans

                            &trans
                            &trans
                            &trans

                            &kp KP_NUMBER_0
                            &kp KP_DOT
                            &kp KP_DIVIDE
            >;
        };
    };
};