#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define GAMING  1
#define NUMBERS 2

/ {
    behaviors {

        // ================================================================
        // ALT + SHIFT LANGUAGE SWITCH
        // Tap = LANG1
        // Hold = ALT
        // ================================================================
        alt_lang: alt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };

        // ================================================================
        // REDO = CTRL + SHIFT + Z
        // ================================================================
        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_press &kp LSHIFT>,
                <&kp Z>,
                <&macro_release &kp LSHIFT>,
                <&macro_release &kp LCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ================================================================
        // DEFAULT
        //
        // CTRL   ALT   SPACE      REDO   BSPC   NUM
        // ================================================================
        default_layer {
            bindings = <
                &kp ESC       &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y         &kp U       &kp I       &kp O       &kp P       &kp ENTER

                &kp TAB       &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H         &kp J       &kp K       &kp L       &kp SEMI     &kp SQT

                &kp LSHFT     &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N         &kp M       &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT

                &kp LCTRL
                &alt_lang LALT LANG1
                &kp SPACE

                &redo
                &kp BSPC
                &tog NUMBERS
            >;
        };

        // ================================================================
        // GAMING
        //
        // Top row = numbers
        // WASD stays in normal position
        //
        // Press GUI position to return to DEFAULT.
        // LGUI is available on the bottom-right position.
        // ================================================================
        gaming_layer {
            bindings = <
                &kp ESC       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5
                &kp N6        &kp N7       &kp N8       &kp N9       &kp N0       &kp ENTER

                &kp TAB       &kp Q        &kp W        &kp E        &kp R        &kp T
                &kp Y         &kp U        &kp I        &kp O        &kp P        &kp SQT

                &kp LCTRL     &kp A        &kp S        &kp D        &kp F        &kp G
                &kp H         &kp J        &kp K        &kp L        &kp SEMI     &kp RSHFT

                &kp LALT
                &kp SPACE
                &kp RCTRL

                &kp LGUI
                &kp BSPC
                &to DEFAULT
            >;
        };

        // ================================================================
        // NUMBERS
        //
        // Right-hand numpad
        //
        //       7   8   9   +
        //       4   5   6   -
        //       1   2   3   *
        //
        // Bottom:
        //       0   .   /
        // ================================================================
        numbers_layer {
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans
                &kp KP_NUMBER_7
                &kp KP_NUMBER_8
                &kp KP_NUMBER_9
                &kp KP_PLUS
                &trans       &trans

                &trans       &trans       &trans       &trans       &trans       &trans
                &kp KP_NUMBER_4
                &kp KP_NUMBER_5
                &kp KP_NUMBER_6
                &kp KP_MINUS
                &trans       &trans

                &trans       &trans       &trans       &trans       &trans       &trans
                &kp KP_NUMBER_1
                &kp KP_NUMBER_2
                &kp KP_NUMBER_3
                &kp KP_MULTIPLY
                &trans       &trans

                &trans
                &trans
                &trans

                &kp KP_NUMBER_0
                &kp KP_DOT
                &kp KP_DIVIDE
            >;
        };
    };
};