#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define GAMING  1
#define NUMBERS 2

/ {
    behaviors {

        // ================================================================
        // ALT + SHIFT LANGUAGE SWITCH
        //
        // Tap  = LANG1
        // Hold = ALT
        // ================================================================
        alt_lang: alt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };

        // ================================================================
        // REDO = CTRL + SHIFT + Z
        // ================================================================
        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_press &kp LSHIFT>,
                <&macro_tap &kp Z>,
                <&macro_release &kp LSHIFT>,
                <&macro_release &kp LCTRL>;
        };

        // ================================================================
        // REDO / NUMBERS
        //
        // Tap  = REDO (CTRL + SHIFT + Z)
        // Hold = NUMBERS layer  (numpad + Bluetooth controls)
        // ================================================================
        redo_numbers: redo_numbers {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&redo>, <&mo NUMBERS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ================================================================
        // DEFAULT
        //
        // | ESC  | Q | W | E | R | T | Y | U | I | O | P | ENTER |
        // | TAB  | A | S | D | F | G | H | J | K | L | ; |  '   |
        // | SHIFT| Z | X | C | V | B | N | M | , | . | / | SHIFT |
        //
        //              CTRL | ALT | SPACE | REDO | BSPC | GAMING |
        // ================================================================
        default_layer {
            bindings = <
                &kp ESC       &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y         &kp U       &kp I       &kp O       &kp P       &kp ENTER

                &kp TAB       &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H         &kp J       &kp K       &kp L       &kp SEMI     &kp SQT

                &kp LSHFT     &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N         &kp M       &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT

                &kp LCTRL
                &alt_lang LALT LANG1
                &kp SPACE

                &redo_numbers
                &kp BSPC
                &tog GAMING
            >;
        };

        // ================================================================
        // GAMING
        //
        // Gaming is TOGGLE:
        // Press GAMING once  = enter Gaming
        // Press GAMING again  = return to Default
        //
        // Leftmost column remains:
        // ESC / TAB / LCTRL
        //
        // WASD is on the LEFT side.
        // ================================================================
        gaming_layer {
            bindings = <
                &kp TAB       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5
                &kp N6        &kp N7       &kp N8       &kp N9       &kp N0       &kp ESC

                &kp LSHFT     &kp Q        &kp W        &kp E        &kp R        &kp T
                &kp Y         &kp U        &kp I        &kp O        &kp P        &kp SQT

                &kp LCTRL     &kp A        &kp S        &kp D        &kp F        &kp G
                &kp H         &kp J        &kp K        &kp L        &kp SEMI     &kp RSHFT

                &kp LCTRL
                &kp LALT
                &kp SPACE

                &kp LGUI
                &kp BSPC
                &to DEFAULT
            >;
        };

        // ================================================================
        // NUMBERS   (hold the REDO thumb key to reach this layer)
        //
        // LEFT hand = Bluetooth / output controls
        //
        //   -   SEL0  SEL1  SEL2  SEL3  SEL4      <- pick a profile slot
        //   -   CLR   OUTts  -     -     -        <- clear THIS profile / toggle USB<>BT
        //   -   CLRA   -     -     -     -        <- clear ALL profiles
        //
        //   BT_SEL n  = switch to Bluetooth profile n (0 = 1st PC, 1 = 2nd PC, ...)
        //   BT_CLR    = forget the bond on the CURRENTLY selected profile
        //   BT_CLR_ALL= forget the bonds on ALL 5 profiles
        //   OUT_TOG   = toggle keyboard output between USB and Bluetooth
        //
        // RIGHT hand = numpad:
        //
        //       7   8   9   +
        //       4   5   6   -
        //       1   2   3   *
        //       0   .   /
        // ================================================================
        numbers_layer {
            bindings = <
                &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &kp KP_NUMBER_7
                &kp KP_NUMBER_8
                &kp KP_NUMBER_9
                &kp KP_PLUS
                &trans       &trans

                &trans       &bt BT_CLR    &out OUT_TOG   &trans       &trans       &trans
                &kp KP_NUMBER_4
                &kp KP_NUMBER_5
                &kp KP_NUMBER_6
                &kp KP_MINUS
                &trans       &trans

                &trans       &bt BT_CLR_ALL &trans        &trans       &trans       &trans
                &kp KP_NUMBER_1
                &kp KP_NUMBER_2
                &kp KP_NUMBER_3
                &kp KP_MULTIPLY
                &trans       &trans

                &trans
                &trans
                &trans

                &kp KP_NUMBER_0
                &kp KP_DOT
                &kp KP_DIVIDE
            >;
        };
    };
};