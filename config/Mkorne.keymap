#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

/ {
    behaviors {
        alt_lang: alt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ---------------------------------------------------------------------------------
// |   Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |
// |   A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |
// |   Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  |
//              | SPC | SPC | SPC |     | SPC | LOW |LARW |
            bindings = <
   &kp ESC       &kp Q       &kp W       &kp E       &kp R       &kp T                              &kp Y         &kp U       &kp I       &kp O       &kp P       &kp ENTER
   &kp TAB       &kp A       &kp S       &kp D       &kp F       &kp G                              &kp H         &kp J       &kp K       &kp L       &kp SEMI     &kp SQT
   &kp LSHFT     &kp Z       &kp X       &kp C       &kp V       &kp B                              &kp N         &kp M       &kp COMMA    &kp DOT     &kp SLASH    &kp RSHFT
                       &lt 1 LGUI  &alt_lang LALT LANG1   &kp SPACE          &kp RCTRL  &kp BSPC   &to 1
            >;
        };

        upper_layer {
// ---------------------------------------------------------------------------------
// |   Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |
// |   A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |
// |   Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  |
//              | SPC | SPC | SPC |     | SPC | LOW |LARW |
            bindings = <
   &trans   &bt BT_CLR     &kp UP     &trans      &trans      &trans                     &kp KP_NUMBER_7      &kp KP_NUMBER_8   &kp KP_NUMBER_9      &kp HOME     &kp PAGE_UP     &trans
   &trans   &kp LEFT   &kp DOWN   &kp RIGHT   &trans      &trans                        &kp KP_NUMBER_4      &kp KP_NUMBER_5   &kp KP_NUMBER_6      &kp END      &kp PAGE_DOWN   &trans
   &trans   &bt BT_CLR_ALL &trans     &trans      &trans      &trans                    &kp KP_NUMBER_1      &kp KP_NUMBER_2   &kp KP_NUMBER_3      &kp DELETE   &kp INSERT      &trans
                                     &trans      &trans   &trans       &trans  &trans   &to 0
            >;
        };
    };
};