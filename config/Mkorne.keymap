#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define GAMING  1
#define NUMBERS 2

/ {
    behaviors {

        // ================================================================
        // ALT + SHIFT LANGUAGE SWITCH
        //
        // Tap  = LANG1
        // Hold = ALT
        // ================================================================
        alt_lang: alt_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&kp>, <&kp>;
        };

        // ================================================================
        // UNREAL MACRO
        //
        // Ctrl + Alt + F11
        // ================================================================
        unreal_macro: unreal_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_press &kp LALT>,
                <&macro_tap &kp F11>,
                <&macro_release &kp LALT>,
                <&macro_release &kp LCTRL>;
        };

        // ================================================================
        // UNREAL MACRO / NUMBERS
        //
        // Tap  = Ctrl + Alt + F11
        // Hold = NUMBERS layer
        //
        // NUMBERS layer contains:
        //   - Bluetooth profile selection
        //   - Bluetooth clear/output controls
        //   - Numpad
        // ================================================================
        unreal_numbers: unreal_numbers {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            // hold = &mo <param1>, tap = &unreal_macro
            bindings = <&mo>, <&unreal_macro>;
        };

        // ================================================================
        // GAMING / DEFAULT LAYER MARKERS
        //
        // F13/F14 are sent first so the PC-side overlay can detect
        // the layer change.
        // ================================================================
        gaming_marker: gaming_marker {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_tap &kp F13>,
                <&tog GAMING>;
        };

        default_marker: default_marker {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_tap &kp F14>,
                <&to DEFAULT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ================================================================
        // DEFAULT
        //
        // | ESC  | Q | W | E | R | T | Y | U | I | O | P | ENTER |
        // | TAB  | A | S | D | F | G | H | J | K | L | ; |  '   |
        // | SHIFT| Z | X | C | V | B | N | M | , | . | / | SHIFT |
        //
        //              CTRL | ALT | SPACE | UNREAL | BSPC | GAMING |
        // ================================================================
        default_layer {
            bindings = <
                &kp ESC       &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y         &kp U       &kp I       &kp O       &kp P       &kp ENTER

                &kp TAB       &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H         &kp J       &kp K       &kp L       &kp SEMI     &kp SQT

                &kp LSHFT     &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N         &kp M       &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT

                &kp LCTRL
                &alt_lang LALT LANG1
                &kp SPACE

                &unreal_numbers NUMBERS 0
                &kp BSPC
                &gaming_marker
            >;
        };

        // ================================================================
        // GAMING
        //
        // Gaming is TOGGLE:
        // Press GAMING once  = enter Gaming
        // Press GAMING again = return to Default
        // ================================================================
        gaming_layer {
            bindings = <
                &kp TAB       &kp Q        &kp W        &kp E        &kp R        &kp T
                &kp Y         &kp U        &kp I        &kp O        &kp P        &kp ESC

                &kp LSHFT     &kp A        &kp S        &kp D        &kp F        &kp G
                &kp H         &kp J        &kp K        &kp L        &kp SEMI     &kp SQT

                &kp LCTRL     &kp Z        &kp X        &kp C        &kp V        &kp B
                &kp N         &kp M        &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT

                &kp LCTRL
                &kp LALT
                &kp SPACE

                &kp LGUI
                &kp BSPC
                &default_marker
            >;
        };

        // ================================================================
        // NUMBERS
        //
        // Hold the UNREAL thumb key to access this layer.
        //
        // LEFT SIDE = Bluetooth / output controls
        //
        // |      | BT0 | BT1 | BT2 | BT3 | BT4 |
        // |      | CLR | OUT |     |     |     |
        // |      | ALL |     |     |     |     |
        //
        // RIGHT SIDE = NUMPAD
        //
        // |  7 |  8 |  9 |  + |     |     |
        // |  4 |  5 |  6 |  - |     |     |
        // |  1 |  2 |  3 |  * |     |     |
        // |  0 |  . |  / |
        //
        // BT_SEL n  = select Bluetooth profile n
        // BT_CLR     = clear current Bluetooth profile
        // BT_CLR_ALL = clear all Bluetooth profiles
        // OUT_TOG    = toggle USB / Bluetooth output
        // ================================================================
        numbers_layer {
            bindings = <
                // Row 1
                &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS  &trans  &trans

                // Row 2
                &trans       &bt BT_CLR    &out OUT_TOG  &trans       &trans       &trans
                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &trans  &trans

                // Row 3
                &trans       &bt BT_CLR_ALL &trans       &trans       &trans       &trans
                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY  &trans  &trans

                // Thumb row
                &trans
                &trans
                &trans

                &kp KP_NUMBER_0
                &kp KP_DOT
                &kp KP_DIVIDE
            >;
        };
    };
};